# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — required for sending workspace invitations via auth.admin API
# Found in: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# GitHub OAuth Configuration — SYNC CONNECTOR ONLY (main/services/github.ts)
# This is NOT used for the "Sign in with GitHub" login button. Login goes through
# Supabase Auth's GitHub provider, configured separately in the Supabase Dashboard
# (Authentication → Providers → GitHub) with callback URL:
#   https://<your-project-ref>.supabase.co/auth/v1/callback
# The vars below are a SEPARATE GitHub OAuth App used only to connect a workspace
# to GitHub for syncing snaps/issues as GitHub issues.
# Register at: https://github.com/settings/developers
# Authorization callback URL should be: http://localhost:3000/auth/github/callback
# Scopes: repo (full control of repositories), user (read user profile)
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# Zoho OAuth Configuration
# Register your app at https://api-console.zoho.com/
# Authorized Redirect URI should be: http://localhost:3000/auth/zoho/callback
# Scopes: ZohoProjects.portals.READ,ZohoProjects.projects.READ,ZohoProjects.bugs.CREATE,ZohoProjects.tasks.CREATE
ZOHO_CLIENT_ID=your-zoho-client-id-here
ZOHO_CLIENT_SECRET=your-zoho-client-secret-here

# Node Environment
NODE_ENV=development
