<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Hardened runtime: required for Electron / V8 JIT -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow loading non-Apple-signed native modules (ffmpeg-static, electron-store native bindings) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network: outgoing requests to Supabase, GitHub, Zoho, auto-update server -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Network: localhost OAuth callback server (background.ts:2147 listens on :3000) -->
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Required for AVFoundation screen capture in capture.ts / recorder.ts -->
    <key>com.apple.security.screen-capture</key>
    <true/>
  </dict>
</plist>
